# Despliegue al lab de AWS (ver docs/deploy-lab.md). Todo es opcional: los valores por defecto sirven.
# Las credenciales de AWS NO van aquí: usa tu perfil (AWS_PROFILE / aws sso login) o las variables de entorno de la cuenta del lab.

# Stage de SST (el que usa platform/).
LAB_STAGE=dev

# Acceso del jurado (opcional). La contraseña es pública cuando se habilita el panel.
JURY_DEMO_ENABLED=false
JURY_DEMO_PASSWORD=

# Modelo de Bedrock para el chat. Vacío = `npm run lab:deploy` detecta solo uno disponible en la cuenta.
LAB_BEDROCK_MODEL_ID=

# Correo del usuario de demostración que crea `npm run lab:user`.
LAB_DEMO_EMAIL=demo@ebc-compass.example
