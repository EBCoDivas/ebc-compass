{
  "name": "ebc-compass-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Despliegue automatizado de EBC Compass al lab de AWS (SST + conocimiento + pruebas de humo). Ver docs/deploy-lab.md.",
  "scripts": {
    "check": "tsx --env-file-if-exists=.env cli.ts check",
    "deploy": "tsx --env-file-if-exists=.env cli.ts deploy",
    "knowledge": "tsx --env-file-if-exists=.env cli.ts knowledge",
    "smoke": "tsx --env-file-if-exists=.env cli.ts smoke",
    "user": "tsx --env-file-if-exists=.env cli.ts user",
    "mcp": "tsx --env-file-if-exists=.env cli.ts mcp",
    "status": "tsx --env-file-if-exists=.env cli.ts status",
    "destroy": "tsx --env-file-if-exists=.env cli.ts destroy",
    "typecheck": "tsc --noEmit",
    "personas": "tsx --env-file-if-exists=.env cli.ts personas"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1170.0",
    "@aws-sdk/client-bedrock-agent": "^3.1170.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1170.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1170.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/client-sts": "^3.1170.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
