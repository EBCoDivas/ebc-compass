# Solo valores públicos: todo lo que empieza con VITE_ queda expuesto en el navegador.
# Nunca pongas claves ni secretos aquí.
VITE_API_URL=http://localhost:3000

# Login del emulador: npm run dev lo activa automáticamente. Desactivar en el lab.
VITE_LOCAL_AUTH=true
# Para AWS real: VITE_COGNITO_USER_POOL_ID y VITE_COGNITO_CLIENT_ID.
