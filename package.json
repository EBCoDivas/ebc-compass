{
  "name": "ebc-compass",
  "private": true,
  "version": "0.1.0",
  "description": "Punto de entrada \u00fanico para los comandos de EBC Compass. Sin dependencias.",
  "type": "module",
  "scripts": {
    "env:create": "node scripts/env-create.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:rules": "node scripts/dev.mjs --rules",
    "stop": "npm --prefix local run down",
    "doctor": "node scripts/doctor.mjs",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "verify:rules": "npm --prefix backend run verify:rules",
    "verify:flow": "npm --prefix backend run verify:flow",
    "verify:lambda": "npm --prefix backend run verify:lambda",
    "verify:llm": "npm --prefix backend run verify:llm",
    "verify:prompt-cache": "npm --prefix backend run verify:prompt-cache",
    "verify:conversations": "npm --prefix backend run verify:conversations",
    "verify:checkpointer": "npm --prefix backend run verify:checkpointer",
    "mcp:verify": "node scripts/with-emulator-env.mjs node --import ./backend/node_modules/tsx/dist/loader.mjs backend/scripts/verify-mcp.ts",
    "lab:mcp": "npm --prefix scripts/lab run -s mcp --",
    "kb:index": "npm --prefix local run kb:index",
    "kb:ingest": "npm --prefix local run kb:ingest",
    "kb:upload": "npm --prefix local run kb:upload",
    "kb:status": "npm --prefix local run kb:status",
    "kb:query": "npm --prefix local run kb:query --",
    "kb:verify": "npm --prefix local run kb:verify",
    "kb:export": "npm --prefix local run kb:export",
    "kb:sync-s3": "npm --prefix local run kb:sync-s3",
    "kb:reset": "npm --prefix local run kb:reset",
    "emulator:up": "npm --prefix local run up",
    "emulator:down": "npm --prefix local run down",
    "provision": "npm --prefix local run provision",
    "bridge": "npm --prefix local run bridge",
    "spike": "npm --prefix local run spike",
    "typecheck": "npm run backend:typecheck && npm run frontend:typecheck && npm run local:typecheck && npm run lab:typecheck",
    "lint": "npm run frontend:lint",
    "build": "npm run backend:build && npm run frontend:build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:preview": "npm --prefix frontend run preview",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "platform:typecheck": "npm --prefix platform run typecheck",
    "platform:test": "npm --prefix platform run test",
    "local:typecheck": "npm --prefix local run typecheck",
    "sst:dev": "node scripts/sst-guard.mjs dev",
    "sst:deploy": "node scripts/sst-guard.mjs deploy",
    "sst:remove": "node scripts/sst-guard.mjs remove",
    "lab:check": "npm --prefix scripts/lab run -s check --",
    "lab:models": "npm --prefix scripts/lab run -s models --",
    "lab:deploy": "npm --prefix scripts/lab run -s deploy --",
    "lab:knowledge": "npm --prefix scripts/lab run -s knowledge --",
    "lab:smoke": "npm --prefix scripts/lab run -s smoke --",
    "lab:user": "npm --prefix scripts/lab run -s user --",
    "lab:status": "npm --prefix scripts/lab run -s status --",
    "lab:destroy": "npm --prefix scripts/lab run -s destroy --",
    "lab:typecheck": "npm --prefix scripts/lab run typecheck",
    "lab:personas": "npm --prefix scripts/lab run -s personas --"
  }
}
