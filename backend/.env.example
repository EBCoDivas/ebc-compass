PORT=3000

# --- Asistente: AWS emulado en local ---
# Las credenciales y el certificado del emulador (~/.aws/emulator/9297/) los inyectan
# los comandos npm; no definas AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aquí.
AWS_REGION=us-east-1
# URL del emulador (HTTPS). Vacío = AWS real.
AWS_ENDPOINT_URL=https://127.0.0.1:9297
# Puente local que responde Bedrock con OpenAI. Vacío = Bedrock real.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=http://127.0.0.1:8787
AWS_ENDPOINT_URL_BEDROCK_AGENT_RUNTIME=http://127.0.0.1:8787

# --- Asistente: comportamiento ---
# llm = el modelo redacta la respuesta; rules = solo plantillas (sin OpenAI).
ASSISTANT_MODE=llm
ASSISTANT_LLM_TIMEOUT_MS=45000
# Identificadores lógicos locales; en el lab se reemplazan por los reales.
BEDROCK_MODEL_ID=local-chat
KNOWLEDGE_BASE_ID=local-kb
CONVERSATIONS_TABLE=ConversationCheckpoints
