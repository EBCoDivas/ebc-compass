{
  "name": "ebc-compass-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts src/assistant/domain/*.test.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:rules": "tsx scripts/verify-rules.ts",
    "verify:llm": "node ../scripts/with-emulator-env.mjs tsx --env-file=.env scripts/verify-llm.ts",
    "verify:checkpointer": "node ../scripts/with-emulator-env.mjs tsx --env-file=.env scripts/verify-checkpointer.ts",
    "verify:flow": "tsx scripts/verify-flow.ts",
    "verify:lambda": "tsx scripts/verify-lambda.ts",
    "verify:auth": "node ../scripts/with-emulator-env.mjs tsx scripts/verify-auth.ts",
    "verify:profiles": "node ../scripts/with-emulator-env.mjs tsx --env-file-if-exists=.env scripts/verify-profiles.ts",
    "verify:stream": "node ../scripts/with-emulator-env.mjs tsx --env-file-if-exists=.env scripts/verify-stream.ts",
    "verify:prompt-cache": "node ../scripts/with-emulator-env.mjs tsx --env-file-if-exists=.env scripts/verify-prompt-cache.ts",
    "verify:conversations": "node ../scripts/with-emulator-env.mjs tsx --env-file-if-exists=.env scripts/verify-conversations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1170.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1170.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1170.0",
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "@langchain/aws": "^1.5.2",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@smithy/node-http-handler": "^4.14.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
