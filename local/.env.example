# Entorno local de EBC Compass (emulador de AWS + puente hacia OpenAI).
# Este archivo solo contiene nombres y valores no secretos.
# Ejecuta `npm run env:create` desde la raíz para crear local/.env y completa ahí tus valores.

# --- AWS Emulator (HTTPS en 127.0.0.1:9297) ---
# Las credenciales y el certificado los genera el emulador en cada arranque
# (~/.aws/emulator/9297/); los comandos npm los inyectan. No pongas credenciales aquí.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297

# Acceso del jurado (opcional). La contraseña es pública cuando se habilita el panel.
JURY_DEMO_ENABLED=false
JURY_DEMO_PASSWORD=

# --- OpenAI (COMPLETA ESTO) ---
# Tu clave de API de OpenAI. Solo la lee el puente local; nunca va al repositorio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high

# --- Base de conocimiento ---
# s3vectors (predeterminado): S3 Vectors del emulador, igual que la Knowledge Base del lab. `npm run dev` la carga sola.
# openai: Vector Store compartido de OpenAI (camino anterior; requiere OPENAI_VECTOR_STORE_ID).
KNOWLEDGE_STORE=s3vectors
# Modelo de OpenAI que responde como Titan Text Embeddings v2 (1,024 dimensiones).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_VECTOR_BUCKET=ebc-compass-knowledge-vectors-local
KNOWLEDGE_VECTOR_INDEX=ebc-compass-knowledge
OPENAI_VECTOR_STORE_NAME=ebc-compass-knowledge
OPENAI_VECTOR_STORE_ID=

# --- Puente local (Bedrock -> OpenAI) ---
BRIDGE_PORT=8787

# --- Ensayo del flujo de producción con S3 emulado ---
KNOWLEDGE_BUCKET=ebc-compass-knowledge-local
